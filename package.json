{
  "name": "skill-tui",
  "version": "0.3.2",
  "description": "Terminal UI for importing Skills (SKILL.md) into AI coding agents: Claude Code, Codex, Cursor, ZCode, OpenClaw, Hermes, OpenCode.",
  "type": "module",
  "license": "MIT",
  "author": "Zhongyuan Lin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coylin-zy/skill-tui.git"
  },
  "bugs": {
    "url": "https://github.com/coylin-zy/skill-tui/issues"
  },
  "homepage": "https://github.com/coylin-zy/skill-tui#readme",
  "keywords": [
    "skill",
    "skills",
    "skill-md",
    "tui",
    "cli",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "ai-agent",
    "ink"
  ],
  "bin": {
    "skilltui": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "files": [
    "dist"
  ]
}
